{
  "name": "aarvion-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node --experimental-strip-types --no-warnings scripts/vercel-build-gate.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit --project ui",
    "test:int": "vitest run --project int",
    "test:e2e": "playwright test",
    "pr-size": "node --experimental-strip-types --no-warnings scripts/pr-size.ts",
    "check:rx-trace": "node --experimental-strip-types --no-warnings scripts/check-rx-trace.ts",
    "fonts:subset": "tsx scripts/subset-fonts.ts",
    "images:sync": "tsx scripts/sync-product-images.ts",
    "format": "prettier --write .",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "db:indexes": "tsx --env-file-if-exists=.env.local scripts/db-indexes.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.3",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "mongodb": "^7.9.1",
    "next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fontkit": "^3.0.0",
    "geist": "^1.9.2",
    "happy-dom": "^21.0.4",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
