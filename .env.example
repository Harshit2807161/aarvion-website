# Copy to .env.local for development. Never commit real values.
# MongoDB connection string (optional until the DB is wired up).
# Local: `pnpm db:up` starts a single-node replica set.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=aarvion
# Public base URL of the site, e.g. https://aarvion.example
APP_URL=
# Set by Vercel: production | preview | development
VERCEL_ENV=
# Set to 1 only to allow mock providers in a production build.
ALLOW_MOCKS_IN_PROD_BUILD=
